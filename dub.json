{
	"name": "easy-installer",
	"description": "Cross-platform installer project host with plugins and in-place PATH registration.",
	"homepage": "https://github.com/dev-centr/easy-installer",
	"authors": ["DevCentr"],
	"license": "MIT",
	"targetType": "executable",
	"targetName": "easy-installer",
	"sourcePaths": ["source", "plugins"],
	"importPaths": ["source", "plugins"],
	"versions": ["EasyInstallerBuiltinPlugins"],
	"configurations": [
		{
			"name": "application",
			"targetType": "executable",
			"mainSourceFile": "source/app.d"
		},
		{
			"name": "library",
			"targetType": "library",
			"excludedSourceFiles": ["source/app.d"]
		}
	]
}
